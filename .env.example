# .env.example
# COPIE PARA .env E PREENCHA COM SEUS VALORES

# .env.example (APENAS EXEMPLO - SEM SECRETS REAIS)
NOTION_TOKEN=seu_token_aqui
NOTION_DATABASE_ID=seu_database_id_aqui

# PERSISTENCIA HISTORICA OPCIONAL (SUPABASE / POSTGREST)
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_KEY=sua_chave_aqui
CV_VERSION=


# CONFIGURAÇÕES OPCIONAIS
LINKEDIN_EMAIL=seu_email@exemplo.com
LINKEDIN_PASSWORD=sua_senha
GITHUB_JOBS_MAX_RESULTS=10

# CONFIGURAÇÕES DE MATCHING
MIN_MATCH_SCORE=40
MAX_VAGAS_POR_PLATAFORMA=20
